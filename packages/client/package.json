{
  "name": "@juegos/client",
  "version": "0.9.0",
  "private": true,
  "description": "Cliente gráfico: Three.js + Vite (Fase 3); Tauri lo empaqueta en la Fase 5",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "vite",
    "empaquetar": "tsc -b && vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.pruebas.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@juegos/carioca-core": "*",
    "@juegos/meloquiz-fuente-local": "*",
    "@juegos/monopoly-core": "*",
    "@juegos/monopoly-fuente-datos": "*",
    "@juegos/rumble-core": "*",
    "@juegos/server": "*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "peerjs": "^1.5.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/three": "^0.180.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
