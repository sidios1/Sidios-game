{
  "name": "@juegos/client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente gráfico: Three.js + Vite (Fase 3); Tauri lo empaqueta en la Fase 5",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "vite",
    "empaquetar": "tsc -b && vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.pruebas.json"
  },
  "dependencies": {
    "@juegos/carioca-core": "*",
    "@juegos/server": "*",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
