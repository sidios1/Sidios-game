{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos base de la ventana + ejecución del sidecar del servidor LAN embebido.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/servidor",
          "sidecar": true,
          "args": []
        }
      ]
    }
  ]
}
