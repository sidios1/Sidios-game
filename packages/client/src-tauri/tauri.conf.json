{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidios Game",
  "version": "0.7.1",
  "identifier": "cl.sidios.sidiosgame",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run empaquetar:sidecar -w @juegos/server && npm run empaquetar -w @juegos/client",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "Sidios Game",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://*:* wss://*:* https://*:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sidios",
    "copyright": "© Sidios",
    "homepage": "https://sidios.cl",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/servidor"]
  }
}
