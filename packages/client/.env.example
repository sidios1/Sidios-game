# Configuración del modo ONLINE (Fase 7). Copia este archivo a `.env.local`
# (gitignored) y completa los valores. Vite solo expone al cliente las
# variables con prefijo VITE_. NUNCA versiones credenciales reales.

# --- ICE: STUN + TURN ---
# STUN público por defecto (no secreto); descomenta para usar otro.
# VITE_STUN_URL=stun:stun.l.google.com:19302

# TURN de respaldo (cuando la conexión directa falla). Sin usuario/credencial
# el TURN se omite y queda solo conexión directa.
# En Android es el MISMO archivo: `tauri android build` corre `vite build`, que
# inyecta este .env.local en `import.meta.env`. No hay paso extra (ver BUILD_ANDROID.md).
VITE_TURN_URL=turn:free.expressturn.com:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- Señalización (PeerJS) ---
# Vacío = broker público gratuito de PeerJS. Para self-hostear el broker,
# completa estos valores (no cambia el resto del código).
# VITE_PEERJS_HOST=
# VITE_PEERJS_PORT=
# VITE_PEERJS_PATH=
# VITE_PEERJS_SECURE=true
# VITE_PEERJS_KEY=

# --- Medición del reloj (TEMPORAL, solo Android) ---
# Build-only de instrumentación: con VITE_MEDICION_RELOJ=1 main.ts carga la sonda
# temporal del reloj del host (src/red/medicionReloj.ts). Ausente/0 = no entra al
# bundle. Se usa para el experimento de MEDICION_RELOJ_ANDROID.md; remover al cerrar.
# VITE_MEDICION_RELOJ=1
