{
  "name": "@juegos/server",
  "version": "0.1.0",
  "private": true,
  "description": "Orquestador autoritativo de partidas + transporte intercambiable (adaptador LAN con ws)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocolo": {
      "types": "./dist/protocolo.d.ts",
      "default": "./dist/protocolo.js"
    },
    "./vista": {
      "types": "./dist/vista.d.ts",
      "default": "./dist/vista.js"
    },
    "./transporte": {
      "types": "./dist/transporte.d.ts",
      "default": "./dist/transporte.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && node dist/dev.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.pruebas.json"
  },
  "dependencies": {
    "@juegos/carioca-core": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
