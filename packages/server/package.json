{
  "name": "@juegos/server",
  "version": "0.1.0",
  "private": true,
  "description": "Orquestador autoritativo de partidas + transporte intercambiable (adaptador LAN con ws)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocolo": {
      "types": "./dist/protocolo.d.ts",
      "default": "./dist/protocolo.js"
    },
    "./vista": {
      "types": "./dist/vista.d.ts",
      "default": "./dist/vista.js"
    },
    "./vistaJuego": {
      "types": "./dist/vistaJuego.d.ts",
      "default": "./dist/vistaJuego.js"
    },
    "./transporte": {
      "types": "./dist/transporte.d.ts",
      "default": "./dist/transporte.js"
    },
    "./latido": {
      "types": "./dist/latido.d.ts",
      "default": "./dist/latido.js"
    },
    "./motor": {
      "types": "./dist/motor.d.ts",
      "default": "./dist/motor.js"
    },
    "./orquestador": {
      "types": "./dist/orquestador.d.ts",
      "default": "./dist/orquestador.js"
    },
    "./registroMotores": {
      "types": "./dist/registroMotores.d.ts",
      "default": "./dist/registroMotores.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && node dist/dev.js",
    "empaquetar:sidecar": "node scripts/construir-sidecar.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.pruebas.json"
  },
  "dependencies": {
    "@juegos/carioca-core": "*",
    "@juegos/mentiroso-core": "*",
    "@juegos/uno-core": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
